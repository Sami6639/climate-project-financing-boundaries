  "H_global": "(min(B-(h*q*q/p+2*delta*q),U-D_delta)-V)/(1+kappa)",
  "D_delta": "(floor(delta/h)+1)*2*h*q+max(0,2*h*q-p*(2*h-(2*delta-floor(delta/h)*2*h)))",
  "H_conservative": "(min(B-q*(h+2*delta),U-2*q*(h+delta))-V)/(1+kappa)",
  "zero_gap_regions_for_0_lt_q_lt_p": [
    "delta/h<=1-q/p, every B,U",
    "1-q/p<delta/h<1 and U-B<=h*q*q/p",
    "delta/h is an integer >=1 and U-B<=h*q"
  ],
